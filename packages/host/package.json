{
  "name": "@codeshare/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/cli.js"
  },
  "bin": {
    "codeshare-host": "./dist/cli.js"
  },
  "scripts": {
    "build": "node esbuild.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@codeshare/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "selfsigned": "^2.4.1",
    "typescript": "^5.6.3",
    "undici": "^7.29.0",
    "vitest": "^5.0.0"
  }
}
